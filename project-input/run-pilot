#!/usr/bin/env python3
"""Rebuild, mine and qualify the complete pinned lzip application in two fresh directories."""
import argparse
import json
from pathlib import Path
import subprocess
import tempfile

here = Path(__file__).resolve().parent
root = here.parent
volume = Path("/run/media/whisper/UNLLM_CORPUS")
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--cache", type=Path, help="verified archives directory for a fully offline repeat")
args = parser.parse_args()
subprocess.run(["mountpoint","-q",volume],check=True)
pair = Path(tempfile.mkdtemp(dir=volume/"unllm/experiments/brick-miner",prefix="project-mining-"))
print(f"Saving to {pair}",flush=True)
cache = args.cache
reports = []
for number in (1,2):
    work = pair/f"run-{number}"
    package = work/"application"
    extra = ["--cache",cache] if cache else []
    subprocess.run(["python3","-B",here/"prepare.py",package,*extra],check=True)
    cache = package/"downloads"
    results = work/"mined"
    subprocess.run([root/"mine-project","--source",package/"source","--database",package/"build",
                    "--provenance",package/"provenance.json","--contracts",root/"contracts/project-lzip.json",
                    "--output",results],check=True)
    subprocess.run(["python3","-B",here/"compare.py",package,work/"comparison"],check=True)
    report = json.loads((results/"report.json").read_bytes())
    del report["seconds"]
    reports.append(report)
if reports[0]!=reports[1]:
    raise RuntimeError(f"Clean repeat differs. See {pair}")
if not reports[0]["bundle_manifest_sha256"]:
    raise RuntimeError("No staged bundle was produced")
print(f"Clean repeat matched. Bundle {pair/'run-1/mined/bundle'}")
print(reports[0]["bundle_manifest_sha256"])
