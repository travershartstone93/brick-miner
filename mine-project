#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
case "${1-}" in
    rows) shift; exec "$root/row-ops/mined/run" "$@" ;;
    shared)
        shift
        if [ "${1-}" = review ]; then shift; exec "$root/shared/review" "$@"; fi
        exec "$root/shared/start" "$@" ;;
esac
make --no-print-directory -s -C "$root" .build/project-miner .build/brick-scan
exec "$root/.build/project-miner" "$@"
