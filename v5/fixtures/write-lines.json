    {"name":"binary-and-utf8","records":["00ff0041","cebb"],"expected_hex":"00ff00410acebb0a"},
    {"name":"embedded-separators","records":["610a62","0d0a",""],"expected_hex":"610a620a0d0a0a0a","existing":true},
    {"name":"missing-parent","records":["61"],"fault":"missing-parent","exception":["Cannot open output"]},
