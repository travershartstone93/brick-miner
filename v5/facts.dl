.decl Provider(cap:symbol, provider:symbol, level:symbol)
.input Provider
.decl Port(provider:symbol, inport:symbol, outport:symbol)
.input Port
.decl Property(provider:symbol, name:symbol, status:symbol)
.input Property
.decl TestedTransform(cap:symbol, inport:symbol, outport:symbol)
TestedTransform(c,i,o) :- Provider(c,p,"ordinary-emission-tested"), Port(p,i,o).
.output TestedTransform
.decl Observed(cap:symbol, property:symbol)
Observed(c,n) :- Provider(c,p,_), Property(p,n,"observed").
.output Observed
.decl LifecycleStep(provider:symbol, trace:symbol, step:number, instance:symbol, subject:symbol, event:symbol, response:symbol)
.input LifecycleStep
.decl ComponentInput(provider:symbol, event:symbol)
.input ComponentInput
.decl ObservedEvent(cap:symbol, event:symbol, response:symbol)
ObservedEvent(c,e,r) :- Provider(c,p,_), Property(p,"state_protocol","observed"), ComponentInput(p,e), LifecycleStep(p,_,_,_,_,e,r).
.output ObservedEvent
.decl ClassBinding(provider:symbol, type:symbol, header:symbol, level:symbol)
.input ClassBinding
.decl ClassMethod(provider:symbol, operation:symbol, member:symbol, parameter:symbol, result:symbol)
.input ClassMethod
.decl ClassValue(provider:symbol, name:symbol, cpp_type:symbol)
.input ClassValue
.decl TestedMethod(provider:symbol, operation:symbol, value_type:symbol)
TestedMethod(p,o,t) :- ClassBinding(p,_,_,"ordinary-header-tested"), ClassMethod(p,o,_,_,_), ClassValue(p,t,_).
.output TestedMethod
.decl SemanticPort(provider:symbol,binding:symbol,direction:symbol,role:symbol,rs:symbol,unit:symbol,us:symbol,card:symbol,cs:symbol)
.input SemanticPort
.decl MeasuredOutput(provider:symbol,binding:symbol,role:symbol,unit:symbol,card:symbol)
MeasuredOutput(p,b,r,u,c) :- Provider(_,p,"ordinary-emission-tested"), SemanticPort(p,b,"output",r,"observed",u,"observed",c,"observed").
.output MeasuredOutput
