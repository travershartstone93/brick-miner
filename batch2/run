#!/usr/bin/env python3
"""Repeat the offline batch twice. Publish only to fresh directories."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

HERE = Path(__file__).resolve().parent
VOLUME = Path("/run/media/whisper/UNLLM_CORPUS")


def pair(root, mode):
    directory = Path(tempfile.mkdtemp(dir=root, prefix="batch2-"))
    reports = []
    for n in (1,2):
        work = directory / f"run-{n}"
        work.mkdir()
        print(f"Run {n} of 2", flush=True)
        subprocess.run(["bwrap", "--die-with-parent", "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc",
                        "--tmpfs", "/tmp", "--bind", work, "/tmp/brick-trial", "--chdir", "/tmp/brick-trial",
                        "--setenv", "LC_ALL", "C", "--setenv", "TZ", "UTC", "--setenv", "PYTHONHASHSEED", "0",
                        "python3","-B",HERE/"qualify.py",mode], check=True)
        reports.append(json.loads((work/"report.json").read_bytes()))
    for name in ("manifest_sha256","header_sha256","verification_sha256","results","provenance","counts","tools"):
        if reports[0][name] != reports[1][name]:
            raise RuntimeError(f"Clean repeat differs in {name}: {directory}")
    print("Clean repeat verified.",flush=True)
    return directory


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--fixture", action="store_true", help="save evidence only; publish into private RAM")
    if parser.parse_args().fixture:
        build = HERE.parent/".build"
        build.mkdir(exist_ok=True)
        with tempfile.TemporaryDirectory(dir=build) as tmp:
            directory=pair(Path(tmp),"fixture")
            dest=Path(tempfile.mkdtemp(prefix="pair-",dir=HERE.parent/"evidence/batch2"))
            for n in (1,2):
                shutil.copyfile(directory/f"run-{n}/report.json",dest/f"run-{n}.json")
            shutil.copyfile(directory/"run-1/payload.SHA256SUMS",dest/"SHA256SUMS")
            print(f"Evidence: {dest}")
    else:
        if subprocess.run(["mountpoint","-q",VOLUME]).returncode:
            parser.exit(2,f"Corpus drive is not mounted at {VOLUME}\n")
        root=VOLUME/"unllm/experiments/brick-miner"
        root.mkdir(parents=True,exist_ok=True)
        if not os.access(root,os.W_OK|os.X_OK):
            parser.exit(2,f"Write access is needed on {root}\n")
        saved=pair(root,"bundle")
        print(f"Candidate bundle: {saved}/run-1/bundle",flush=True)


if __name__ == "__main__":
    main()
